#!/bin/sh

. /lib/functions.sh

# OpenWrt acme-common owns scheduling and acme-acmesh owns account/key state.
# Only nginx_proxy_* sections are managed here; unrelated ACME jobs are retained.
fail() { echo "nginx-proxy: $*" >&2; exit 1; }

collect() {
	local section="$1" enabled source domain email
	config_get_bool enabled "$section" enabled 1
	config_get source "$section" certificate_source manual
	[ "$ACTIVE" = 1 ] && [ "$enabled" = 1 ] && [ "$source" = acme ] || return 0
	config_get domain "$section" domain
	domain="$(printf '%s' "$domain" | tr 'A-Z' 'a-z')"
	echo "$domain" | grep -Eq '^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$' ||
		fail 'HTTP-01 requires a valid non-wildcard domain'
	case "$section" in ''|*[!A-Za-z0-9_]*) fail 'invalid section identifier' ;; esac
	[ "$HTTP_PORT" = 80 ] || fail 'HTTP-01 requires HTTP port 80'
	config_get email "$section" acme_email "$GLOBAL_EMAIL"
	[ -n "$email" ] || email="admin@$domain"
	echo "$email" | grep -Eq '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$' || fail 'enter a valid ACME account email'
	[ -n "$DEFAULT_EMAIL" ] || DEFAULT_EMAIL="$email"
	SITES="$SITES $section:$domain"
}

load_sites() {
	SITES=
	DEFAULT_EMAIL=
	config_load nginx_proxy
	config_get_bool ACTIVE main enabled 0
	[ "${1-}" != disable ] || ACTIVE=0
	config_get HTTP_PORT main management_http_port 80
	config_get GLOBAL_EMAIL main acme_email
	config_foreach collect reverse_proxy
}

select_site() {
	case "${1-}" in ''|*[!A-Za-z0-9_]*) fail 'invalid site identifier' ;; esac
	[ "${#1}" -le 64 ] || fail 'invalid site identifier'
	SELECTED="$1"
	load_sites
	case " $SITES " in *" $SELECTED:"*) ;; *) fail 'select an enabled automatic certificate site' ;; esac
}

sync_config() {
	local item section domain email global old
	load_sites "${1-}"
	if [ -n "$SITES" ]; then
		[ -x /etc/init.d/acme ] || fail 'install acme-acmesh first'
	fi
	# Validate everything before modifying shared ACME configuration.
	for old in $(uci -q show acme | sed -n 's/^acme\.\(nginx_proxy_[A-Za-z0-9_]*\)=cert$/\1/p'); do
		uci -q delete "acme.$old"
	done
	if [ -n "$SITES" ]; then
		global="$(uci -q show acme | sed -n 's/^acme\.\([^=]*\)=acme$/\1/p' | head -n 1)"
		[ -n "$global" ] || global="$(uci add acme acme)"
		uci set "acme.$global.account_email=$DEFAULT_EMAIL"
		for item in $SITES; do
			section="nginx_proxy_${item%%:*}"
			domain="${item#*:}"
			config_get email "${item%%:*}" acme_email "$GLOBAL_EMAIL"
			[ -n "$email" ] || email="admin@$domain"
			uci set "acme.$section=cert"
			uci set "acme.$section.account_email=$email"
			uci set "acme.$section.enabled=1"
			uci set "acme.$section.validation_method=webroot"
			uci set "acme.$section.key_type=ec256"
			uci set "acme.$section.staging=0"
			uci add_list "acme.$section.domains=$domain"
		done
	fi
	uci commit acme || return 1
	if [ -n "$SITES" ]; then
		mkdir -p /var/run/acme/challenge
		/etc/init.d/acme enable
		/etc/init.d/acme start
		/etc/init.d/cron enable
		/etc/init.d/cron start
	fi
}

# Use the installed ACME wrapper's own configuration loader and certificate
# hook, but select just one cert section. Daily cron still uses normal renew.
renew_site() (
	extra_command() { :; }
	. /etc/init.d/acme
	mkdir -p "$run_dir" "$CHALLENGE_DIR"
	trap cleanup EXIT
	config_load acme
	config_foreach load_globals acme
	config_get account_email "nginx_proxy_$SELECTED" account_email "$account_email"
	export account_email
	get_cert "nginx_proxy_$SELECTED"
)

case "$1" in
	sync) sync_config "${2-}" ;;
	start)
		select_site "${2-}"
		/etc/init.d/nginx-proxy running || fail 'enable and apply the proxy first'
		# ponytail: one manual request at a time because ACME account state is shared.
		mkdir /var/run/nginx-proxy-acme.lock 2>/dev/null || fail 'certificate check already running'
		printf '%s\n' "$SELECTED" > /var/run/nginx-proxy-acme.lock/section
		umask 077
		"$0" run "$SELECTED" </dev/null >"/var/run/nginx-proxy-acme-$SELECTED.log" 2>&1 &
		;;
	run)
		trap 'rm -f /var/run/nginx-proxy-acme.lock/section; rmdir /var/run/nginx-proxy-acme.lock' EXIT
		trap 'exit 1' HUP INT TERM
		select_site "${2-}"
		renew_site
		;;
	status)
		select_site "${2-}"
		if [ "$(cat /var/run/nginx-proxy-acme.lock/section 2>/dev/null)" = "$SELECTED" ]; then echo 'Certificate check running'; fi
		config_get domain "$SELECTED" domain
		domain="$(printf '%s' "$domain" | tr 'A-Z' 'a-z')"
		echo "$domain:"
		openssl x509 -in "/etc/ssl/acme/$domain.fullchain.crt" -noout -enddate 2>/dev/null || echo 'Awaiting certificate'
		tail -n 15 "/var/run/nginx-proxy-acme-$SELECTED.log" 2>/dev/null
		exit 0
		;;
	*) echo "Usage: $0 sync [disable] | [start|run|status] SECTION" >&2; exit 2 ;;
esac
